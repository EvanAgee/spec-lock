#!/usr/bin/env node
// The GitHub action adapter. It judges the pushed commit (GITHUB_SHA) as a landing on the target
// branch (INPUT_TARGET), from the target's tip at the moment the check runs, never the push event's
// before value, which is the candidate branch's previous tip. It runs the same `spec-lock check`
// the git hook uses, so both print the same verdict and checker line for the same range.
// Run it on pushes to candidate branches and push the checked commit to the target afterwards:
// a required check has to pass on a commit before a protected branch accepts it.
import { execFileSync, spawnSync } from 'node:child_process'
import { fileURLToPath } from 'node:url'

const git = (...args) => execFileSync('git', args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim()
const target = process.env.INPUT_TARGET
const neu = process.env.GITHUB_SHA
try {
  if (!target || !neu) throw new Error('needs the target input and GITHUB_SHA')
  // A push to the target has already landed, and its tip is the new commit: comparing the two
  // would check an empty range and pass anything.
  if (process.env.GITHUB_REF === `refs/heads/${target}`) {
    throw new Error(`this push is to ${target} itself, which has already landed it; run the check on pushes to candidate branches`)
  }
  // actions/checkout fetches one commit by default; a deeper fetch of the target is not needed,
  // and --depth in a full clone would cut its history short.
  const depth = git('rev-parse', '--is-shallow-repository') === 'true' ? ['--depth=1'] : []
  git('fetch', '--quiet', '--no-tags', ...depth, 'origin', `+refs/heads/${target}:refs/remotes/origin/${target}`)
  const old = git('rev-parse', '--verify', '--end-of-options', `refs/remotes/origin/${target}^{commit}`)
  process.stdout.write(`spec-lock: checking ${neu} as a landing on ${target} at ${old}\n`)
  const r = spawnSync(process.execPath, [fileURLToPath(new URL('spec-lock', import.meta.url)), 'check', old, neu], { stdio: 'inherit' })
  if (r.error) throw r.error
  process.exit(r.status ?? 2)
} catch (e) {
  process.stderr.write(`spec-lock: ${(e.stderr?.trim() || e.message).split('\n')[0]}\n`)
  process.exit(2)
}
