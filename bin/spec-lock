#!/usr/bin/env node
// spec-lock check <old> <new>        exit 0 when moving a protected branch from old to new may land
// spec-lock reference-transaction    the git hook adapter; reads "<old> <new> <ref>" lines on stdin
// Exit 1 is a refusal with its reasons; exit 2 means the check could not run, which also refuses.
import { readFileSync } from 'node:fs'
import { checkRange, referenceTransaction } from '../lib/lock.mjs'

const [cmd, ...args] = process.argv.slice(2)
try {
  if (cmd === 'check' && args.length === 2) {
    const faults = checkRange(args[0], args[1])
    if (faults.length) {
      process.stdout.write(`spec-lock: refused ${args[0]}..${args[1]}\n${faults.map((f) => `- ${f}`).join('\n')}\n`)
      process.exit(1)
    }
    process.stdout.write('spec-lock: ok\n')
  } else if (cmd === 'reference-transaction') {
    const out = referenceTransaction(readFileSync(0, 'utf8'))
    if (out.length) {
      process.stderr.write(out.join('\n') + '\n')
      process.exit(1)
    }
  } else {
    process.stderr.write('usage: spec-lock check <old> <new>\n       spec-lock reference-transaction < updates\n')
    process.exit(2)
  }
} catch (e) {
  process.stderr.write(`spec-lock: ${e.message.split('\n')[0]}\n`)
  process.exit(2)
}
