#!/bin/sh
# Git hook adapter for spec-lock. Git runs it as: spec-lock-hook <event> <hook args...>
# The events are reference-transaction, for local branch moves, and pre-push, for the remote branch
# a push would move. It decides which updates are checked: the guarded branches of a repository that
# is selected, or is not opted out under legacy mode. Valid scope leaves other updates untouched.
# Missing or malformed selected settings refuse all head updates before filtering. It uses only
# shell builtins and git, because git may run it with a PATH that holds neither Node nor the usual tools.
# It fails closed: a missing Node, a crashed checker or an unreadable object refuses a guarded update.
# A --plain registration also reads the owner's plain file and applies the plain proof rule there.
set -f
event=$1
shift
selected_registration=0
plain_registration=0
case $1 in
--selected) selected_registration=1; shift ;;
--plain) selected_registration=1; plain_registration=1; shift ;;
esac
case $event in
reference-transaction)
  # prepared can still stop an update; committed keeps the tip a landing left behind.
  case $1 in prepared|committed) state=$1 ;; *) exit 0 ;; esac ;;
pre-push)
  # Git passes the remote's name and URL; a refusal stops the whole push, as in prepared.
  state=prepared ;;
*)
  echo "spec-lock: unknown hook event '$event', refusing" >&2
  exit 1 ;;
esac
# Git runs this for every ref, HEAD included, even while git init is still building the repository,
# so nothing else runs until a branch is in the update.
input=
while read -r line; do input="$input$line
"; done
case $input in *" refs/heads/"*) ;; *) exit 0 ;; esac

# The owner's central file: selected mode/evidence/select entries, integration branches,
# or legacy integration/opt-out entries.
# Only HOME places it: an environment variable of its own would let any process opt a repository out.
config=$HOME/.config/spec-lock/config
listed() {
  [ -r "$config" ] || return 0
  while read -r key value || [ -n "$key$value" ]; do [ "$key" = "$1" ] && printf '%s\n' "$value"; done < "$config"
}

policy_error() {
  [ "$state" = committed ] && exit 0
  echo "spec-lock: required policy is missing or malformed; refusing" >&2
  if command -v node >/dev/null 2>&1; then node "${0%/*}/spec-lock" policy >&2; fi
  exit 1
}

# Shell variables discard NUL bytes. Hash an exact line round-trip before parsing;
# no object is written, and no Node or external text utility is needed.
exact() {
  file_hash=$(git hash-object --no-filters "$1") || policy_error
  text_hash=$({ while IFS= read -r raw; do printf '%s\n' "$raw"; done; printf '%s' "$raw"; } < "$1" | git hash-object --stdin) || policy_error
  [ "$file_hash" = "$text_hash" ] || policy_error
}
[ -r "$config" ] && exact "$config"

# Selected registrations never fall back when the owner file disappears. Validate scope
# using only shell builtins and Git, so unselected repositories need no Node.
selected_mode=$selected_registration
if [ -r "$config" ]; then
  while read -r key value || [ -n "$key$value" ]; do
    case $key in mode|select|evidence) selected_mode=1 ;; esac
  done < "$config"
fi

if [ "$selected_mode" = 1 ]; then
  [ -r "$config" ] || policy_error
  common=$(git rev-parse --path-format=absolute --git-common-dir) && common=$(cd "$common" && pwd -P) || policy_error
  mode_seen=0
  evidence_seen=0
  chosen=0
  selections=
  carriage_return=$(printf '\r')
  integrations=
  while read -r key value || [ -n "$key$value" ]; do
    case "$key$value" in *"$carriage_return"*) policy_error ;; esac
    case $key in
      ''|'#'*) continue ;;
      mode) [ "$mode_seen" = 0 ] && [ "$value" = selected ] || policy_error; mode_seen=1 ;;
      evidence) [ "$evidence_seen" = 0 ] || policy_error; case $value in semantic-v2|legacy) ;; *) policy_error ;; esac; evidence_seen=1 ;;
      select)
        case $value in /*) ;; *) policy_error ;; esac
        canonical=$(cd "$value" 2>/dev/null && pwd -P) || policy_error
        [ "$canonical" = "$value" ] || policy_error
        git_common=$(unset GIT_COMMON_DIR GIT_WORK_TREE; git --git-dir="$value" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || policy_error
        git_common=$(cd "$git_common" && pwd -P) || policy_error
        [ "$git_common" -ef "$value" ] || policy_error
        previous_ifs=$IFS
        IFS='
'
        for selected in $selections; do [ "$selected" -ef "$value" ] && policy_error; done
        IFS=$previous_ifs
        selections="$selections$value
"
        [ "$value" -ef "$common" ] && chosen=1 ;;
      integration)
        git check-ref-format "refs/heads/$value" >/dev/null 2>&1 || policy_error
        case "
$integrations" in *"
$value
"*) policy_error ;; esac
        integrations="$integrations$value
" ;;
      *) policy_error ;;
    esac
  done < "$config"
  [ "$mode_seen" = 1 ] && [ "$evidence_seen" = 1 ] || policy_error
  if [ "$chosen" != 1 ]; then
    # A plain registration checks its repository only while the owner's plain file lists it.
    [ "$plain_registration" = 1 ] || exit 0
    plain=$HOME/.config/spec-lock/plain
    [ -r "$plain" ] || policy_error
    exact "$plain"
    covered=0
    while read -r key value || [ -n "$key$value" ]; do
      case "$key$value" in *"$carriage_return"*) policy_error ;; esac
      case $key in
        ''|'#'*) continue ;;
        plain) case $value in /*) ;; *) policy_error ;; esac
          [ "$value" -ef "$common" ] && covered=1 ;;
        *) policy_error ;;
      esac
    done < "$plain"
    [ "$covered" = 1 ] || exit 0
  fi
fi

# Guarded: every remote's default branch, main and master, and the listed integration branches.
guarded="main
master
$(git for-each-ref --format='%(symref:lstrip=3)' 'refs/remotes/*/HEAD')
$(listed integration)"
updates=
IFS='
'
for line in $input; do
  # reference-transaction lines are "<old> <new> <ref>"; pre-push lines are
  # "<local ref> <local oid> <remote ref> <remote oid>", and the remote ref is what a push moves.
  ref=${line##* }
  [ "$event" = pre-push ] && ref=${line#* * } && ref=${ref%% *}
  for name in $guarded; do
    [ "$ref" = "refs/heads/$name" ] && updates="$updates$line
" && break
  done
done
unset IFS
[ -n "$updates" ] || exit 0

# The repository: its main worktree, or the repository itself when bare, so linked worktrees match too.
repo=$(git rev-parse --path-format=absolute --git-common-dir) && repo=$(cd "${repo%/.git}" && pwd -P) || exit 1
listed opt-out | while read -r dir; do
  case $dir in /*) [ "$(cd "$dir" 2>/dev/null && pwd -P)" = "$repo" ] && exit 3 ;; esac
done
if [ $? = 3 ]; then
  [ "$state" = prepared ] && echo "spec-lock: not checked: $repo is on the opt-out list in $config" >&2
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  [ "$state" = committed ] && exit 0
  echo "spec-lock: node is not on PATH, so this update of a guarded branch cannot be checked and is refused. Put node on the PATH this git runs with." >&2
  exit 1
fi
# The first hook argument is the state for reference-transaction and the remote for pre-push.
printf '%s' "$updates" | node "${0%/*}/spec-lock" "$event" "$1" "$repo" $guarded
status=$?
[ "$state" = committed ] && exit 0
[ "$status" -le 1 ] && exit "$status"
echo "spec-lock: the checker failed (exit $status), so the update is refused." >&2
exit 1
